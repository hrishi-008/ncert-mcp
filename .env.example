# Copy to .env and fill in. Never commit .env.

# Long random string; it is part of the secret URL: https://ncert.hrishk.com/<SECRET_TOKEN>/mcp
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_TOKEN=

# Where the teacher's notes + paper log live. Must be on persistent disk.
# In Docker this is the mounted volume; locally a file in data/.
STATE_DB_URL=sqlite:////data/state/state.db

# Read-only book database built by the ingestion pipeline (shipped inside the image).
BOOKS_DB_PATH=/app/data/books.db

RATE_LIMIT_PER_MIN=60
LOG_LEVEL=INFO

# Only for the OFFLINE ingestion steps (Maths vision pass, LLM structuring, old->new map draft).
# The server never calls the API.
ANTHROPIC_API_KEY=
